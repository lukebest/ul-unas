    "training/data/manifests/dev_vbdemand.jsonl",
    "training/data/manifests/dev_mssnsd.jsonl"
  ],
  "output_dir": "training/outputs/finetune_mssnsd_demandex",
  "freeze": "decoder_tail",
  "lr": 1e-5,
  "batch_size": 8,
  "seconds": 2.0,
  "epochs": 1,
  "max_steps": 80,
  "max_dev": 24,
  "w_mag": 10,
  "w_ri": 5,
  "w_sisnr": 1,
  "w_prot": 2,
