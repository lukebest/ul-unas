{
  "sample_rate": 16000,
  "hop": 256,
  "n_fft": 512,
  "dataset": "MS-SNSD + VB-DemandEx continue-train",
  "init_ckpt": "training/outputs/finetune_vbdemand/ulunas_finetuned.pt",
  "init_ckpt_fallback": "checkpoints/model_trained_on_dns3.tar",
  "train_manifests": [
    "training/data/manifests/train_mssnsd.jsonl",
    "training/data/manifests/train_vbdemandex.jsonl"
